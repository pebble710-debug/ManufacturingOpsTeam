# Copy to .env for local overrides. .env is git-ignored. ALL VALUES BELOW ARE FAKE.
# Never commit real secrets. On Netlify, set variables in the UI (Site configuration > Environment variables).

# Injected automatically by Netlify at build/runtime, and by `astro dev` locally (emulator).
# Only set it by hand to point scripts (db:migrate, db:reset-seed) at a specific database.
# NETLIFY_DB_URL=postgres://user:fake-password@localhost:5432/postgres

# Enables the Admin-only "Reset demo data" action (POST /api/v1/admin/demo-reset). Default false.
DEMO_RESET_ENABLED=false

# Demo-only seeded password for demo users. Fictional, never reuse for anything real.
# Production: set a value in the Netlify UI (do not commit it). Local default is documented in the README.
DEMO_ADMIN_PASSWORD=change-me-demo-only

# Netlify build Node version (must match .nvmrc).
NODE_VERSION=22.23.5
