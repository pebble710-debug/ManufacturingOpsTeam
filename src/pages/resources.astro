---
// Resources (US-085, P-29): static links only; no database access, no user input.
// Content source: docs/plan/resources.md via components/resources-data.ts.
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { appLocals } from '../components/locals';
import { resourceGroups } from '../components/resources-data';

export const prerender = false;

const { user } = appLocals(Astro.locals);
// Signed-in only; middleware also enforces this.
if (!user) return Astro.redirect('/login?reason=required&next=/resources');
---
<AppLayout title="Resources" description="Official documentation, standards and project documents (fictional demo system).">
  <PageHeader title="Resources" crumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Resources' }]} />
  <p class="lead prose">Official documentation for the technologies this prototype uses, standards it follows, and the project's own research and design documents. All companies, customers, parts and records in this application are fictional.</p>

  <div class="stack stack--lg">
    {resourceGroups.map((g) => (
      <section class="page-section" aria-labelledby={`res-${g.id}`}>
        <h2 id={`res-${g.id}`}>{g.title}</h2>
        {g.intro && <p class="text-muted">{g.intro}</p>}
        <ul class="stack stack--sm" role="list">
          {g.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}<span class="visually-hidden"> (opens external site)</span> <Icon name="external" /></a>
              <br /><span class="text-muted">{l.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</AppLayout>
