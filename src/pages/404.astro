---
import AppLayout from '../layouts/AppLayout.astro';
import { appLocals } from '../components/locals';
export const prerender = false;
const { user } = appLocals(Astro.locals);
Astro.response.status = 404;
---
<AppLayout title="Page not found">
  <div class="error-state" role="group" aria-labelledby="nf-title">
    <h1 class="error-state__title" id="nf-title">We can't find that page</h1>
    <p class="error-state__text">The shipment or page may not exist. Check the number and try again.</p>
    <div class="error-state__actions">
      {user ? (<><a class="btn btn--primary" href="/shipments">Go to Shipments</a><a class="btn btn--secondary" href="/dashboard">Dashboard</a></>)
            : <a class="btn btn--primary" href="/login">Sign in</a>}
    </div>
  </div>
</AppLayout>
