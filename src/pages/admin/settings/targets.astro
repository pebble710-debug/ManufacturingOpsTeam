---
// POST /admin/settings/targets (form route); re-renders Settings with the errors on failure.
import SettingsView from '../../../components/admin/SettingsView.astro';
import { settingsPage } from '../../../components/admin/settings-actions';
export const prerender = false;
if (Astro.request.method !== 'POST') return Astro.redirect('/admin/settings');
const r = await settingsPage(Astro, 'targets');
if (r.response) return r.response;
---
<SettingsView settings={r.settings} failure={r.failure} failedForm={r.failedForm} />
