---
// POST /admin/lookups/{type}/{id} (F-lookup-update): re-renders the list with the error on failure. GET redirects to the list.
import LookupList from '../../../../components/admin/LookupList.astro';
import { lookupPage } from '../../../../components/admin/lookup-actions';
export const prerender = false;
if (Astro.request.method !== 'POST') return Astro.redirect(`/admin/lookups/${Astro.params.type}`);
const r = await lookupPage(Astro, 'update');
if (r.response) return r.response;
if (r.notFound) return Astro.rewrite('/404');
---
<LookupList type={r.type} rows={r.rows} failure={r.failure} failedId={r.failedId} />
