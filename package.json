{
  "name": "manufacturing-ops-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manufacturing Shipping & Inventory Operations Dashboard - educational prototype, fictional data only (Cobalt Ridge Components, Inc.).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "check": "astro check",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "node scripts/migrate.ts",
    "db:reset-seed": "node scripts/reset-seed.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.14",
    "@netlify/database": "2.0.4",
    "astro": "7.4.13",
    "chart.js": "4.6.2",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@netlify/database-dev": "1.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
